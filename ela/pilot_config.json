{
  "name": "set-b-roughness",
  "description": "Set B tuned for asymmetry (gamma_Y) and local roughness (median_lipschitz). linearity_penalty=0, campaign GP ops, upweighted skew+Lipschitz.",

  "mode": "anchored",

  "data": {
    "db": "data/2nd_real_run.db",
    "target": "data/2nd_real_run_ela_full.json"
  },

  "fitness": {
    "munoz_8_fitness": false,
    "fitness_features": [
      "R2_Q",
      "R2_QI",
      "CN",
      "H_Y",
      "gamma_Y",
      "EL25",
      "LQ25",
      "PKS",
      "FDC",
      "median_lipschitz"
    ],
    "tier1_weights": {
      "R2_Q": 0.75,
      "R2_QI": 0.75,
      "CN": 0.5,
      "H_Y": 0.75,
      "gamma_Y": 2.5,
      "EL25": 0.75,
      "LQ25": 0.75,
      "PKS": 1.0,
      "FDC": 0.75,
      "median_lipschitz": 3.0
    },
    "alpha_subspace": 0.25,
    "beta_complexity": 0.001,
    "tier1_gamma": 2.0,
    "linearity_penalty_gamma": 0,
    "subspace_rmse_frac": 0.02,
    "tier1_acceptance_median_rel": 0.1,
    "linear_calibration": false,
    "require_subspace_rmse": false
  },

  "ga": {
    "paper_ga": false,
    "population": 400,
    "generations": 100,
    "tournament_k": 10,
    "crossover_prob": 0.6,
    "mutation_prob": 0.3,
    "direct_transfer_prob": 0.1,
    "elitism_frac": 0.1,
    "max_tree_depth": 12,
    "fitness_stop_threshold": 0.001,
    "early_reject_subspace_mult": 0.0
  },

  "sampling": {
    "n_dense": null
  },

  "viz": {
    "snapshot_every": 5,
    "landscape_viz": true,
    "landscape_every": 1,
    "landscape_grid_n": 100,
    "post_viz": true,
    "grid_n": 200
  },

  "runtime": {
    "eval_workers": 8,
    "log_level": "INFO",
    "seed": null,
    "quick": false
  }
}
