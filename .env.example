# Copy this file to `.env` (same directory, repo root) and fill in your key.
# `.env` is gitignored, so your key never gets committed. It is loaded
# automatically by llm/llm_config.py on import (repo-root .env first, then
# llm/.env), so the LLM sweeps pick it up without any manual `export`.
#
# A real environment variable always takes precedence over this file.

# Anthropic API key used by the LLM-in-the-loop experiments (llm/).
ANTHROPIC_API_KEY=sk-ant-...
